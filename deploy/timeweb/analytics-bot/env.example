# Dedicated bot from BotFather; never reuse the alert/Ops token.
ANALYTICS_BOT_TOKEN=
ANALYTICS_BOT_CHAT_ID=
# Optional existing Aeza /tg endpoint and its secret (never in git):
ANALYTICS_BOT_TELEGRAM_BASE_URL=https://api.telegram.org
ANALYTICS_BOT_PROXY_SECRET=
# Optional read-only PostgreSQL role, only SELECT analytics.v_orders. ssl=require.
ANALYTICS_BOT_SALES_DATABASE_URL=
ANALYTICS_BOT_DAILY_ENABLED=false
ANALYTICS_BOT_DAILY_HOUR_MSK=9
ANALYTICS_BOT_STATE_PATH=/data/analytics-bot.sqlite3

# Interactive analyst, same OpenAI proxy pattern as Ops; never local Codex auth.
ANALYTICS_BOT_OPENAI_API_KEY=
ANALYTICS_BOT_OPENAI_BASE_URL=https://api.openai.com/v1
ANALYTICS_BOT_OPENAI_PROXY_SECRET=
ANALYTICS_BOT_OPENAI_MODEL=gpt-6.1-sol
ANALYTICS_BOT_DAILY_QUESTION_LIMIT=50
