# Переменные бота — те же, что workflow деплоя передаёт в Yandex.
# Скопировать в .env.bot (chmod 600) и заполнить пустые значения: секреты
# из локального .env или из того, где они хранятся. Файл .env.bot в git не класть.
# Очередь Yandex и Monitoring здесь не нужны — задаются в docker-compose.yml.
APP_REVISION=timeweb
VK_CONFIRMATION_TOKEN=
VK_SECRET_KEY=
VK_GROUP_ID=
VK_ACCESS_TOKEN=
VK_USER_TOKEN=
ADMIN_VK_ID=
VK_API_VERSION=5.199
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_EFFORT=low
OPENAI_MAX_TOKENS=8000
OPENAI_TIMEOUT_SECONDS=25
OPENAI_BASE_URL=
OPENAI_PROXY_SECRET=
OPS_ASSISTANT_MODEL=gpt-6.1-sol
OPS_ASSISTANT_EFFORT=low
# Postgres на этой же ВМ — хост host.docker.internal (порт, база, пароль — как в секрете GitHub).
DATABASE_URL=
CDEK_API_BASE_URL=https://api.cdek.ru
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
CDEK_FROM_ADDRESS=
CDEK_SHIPMENT_POINT=KSD296
CDEK_DEFAULT_PACKAGE_WEIGHT_GRAMS=200
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=
TELEGRAM_API_BASE_URL=
TELEGRAM_PROXY_SECRET=
TELEGRAM_REPORTS_CHAT_ID=
TELEGRAM_ORDERS_CHAT_ID=
TELEGRAM_OPS_CHAT_ID=
# Ассистент в чате Ops (docs/monitoring.md): отвечает, если отметить бота.
OPS_ASSISTANT_ENABLED=false
INTERNAL_API_TOKEN=
OZON_CLIENT_ID=
OZON_CLIENT_SECRET=
OZON_SHIPMENT_METHOD_ID=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=
RUSSIAN_POST_ENABLED=false
PAYMENTS_ENABLED=true
PUBLIC_BASE_URL=https://<BOT_DOMAIN>
SETTLEMENT_RECEIPT_ENABLED=false
AUTO_INVOICE_ENABLED=true
VK_BUTTONS_ENABLED=true
RETURNING_ONE_QUESTION_ENABLED=true
REPEAT_ONE_TAP_ENABLED=true
RETURNING_INSTANT_INVOICE_ENABLED=true
TAKE_BUTTONS_ENABLED=true
STOREFRONT_DIRECT_POINTS_ENABLED=true
DELIVERY_DATE_ENABLED=true
DELIVERY_UPGRADE_PRICING_ENABLED=true
STOREFRONT_DIRECT_OZON_ENABLED=true
STOREFRONT_RESPECT_VK_DELIVERY=false
GEO_LOCATION_ENABLED=true
SINGLE_POINT_INSTANT_ENABLED=true
STOREFRONT_EARLY_NUDGE_ENABLED=true
MESSAGE_DEBOUNCE_SECONDS_DEFAULT=2
MESSAGE_DEBOUNCE_SECONDS_COLLECTING=5
FEEDBACK_ASK_ENABLED=true
REPEAT_NUDGE_ENABLED=true
SECOND_TOUCH_ENABLED=true
REACTIVATION_ENABLED=true
BREWING_IN_DELIVERED_ENABLED=true
PURCHASE_HISTORY_IN_PROMPT_ENABLED=true
MARKETING_MIN_GAP_DAYS=3
BREWING_GUIDE_URL=
TEST_VK_IDS=
TEST_PAID_BEFORE=
CLIENT_KEY_SECRET=
PII_ENCRYPTION_KEY=
PII_TOKENS_ENABLED=true
CATALOG_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vTD7glBYgxBckFfhm5IqPPTTxa0MEZPehjuyIM9yFsNvYczGsD3zHNdVdDeTqgb_vi29r5sdZ9v4sGe/pub?output=csv
# Каталог из Google Таблицы. public — по опубликованной ссылке
# CATALOG_SHEET_CSV_URL (как раньше); service_account — Sheets API сервисным
# аккаунтом, только чтение: таблицу тогда можно закрыть от интернета.
# Порядок переключения — docs/infrastructure.md, «Каталог: сервисный аккаунт».
SHEETS_AUTH_MODE=public
CATALOG_SHEET_ID=
CATALOG_SHEET_TAB=Untitled
# JSON-ключ сервисного аккаунта: целиком в GOOGLE_SA_JSON или base64 одной
# строкой в GOOGLE_SA_JSON_B64 (для .env-файла удобнее второе). Секрет.
GOOGLE_SA_JSON=
GOOGLE_SA_JSON_B64=
