APP_NAME=Tea Shop VK Bot Backend
DEBUG=True

# VK Callback API (Управление сообществом -> Работа с API -> Callback API)
VK_CONFIRMATION_TOKEN=
VK_SECRET_KEY=
VK_GROUP_ID=
# VK Callback API (Управление сообществом -> Работа с API -> Ключи доступа)
VK_ACCESS_TOKEN=
VK_API_VERSION=5.199

# Claude (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# CDEK API. Ключи приходят письмом при регистрации личного кабинета — они
# боевые. Песочница (https://api.edu.cdek.ru) работает на отдельных ключах,
# которые выдаёт менеджер СДЭКа; боевые там дают 401 invalid_client.
CDEK_API_BASE_URL=https://api.cdek.ru
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# Откуда отвозим посылки — от этого адреса считается тариф
CDEK_FROM_ADDRESS=
# Код отделения СДЭК, куда сдаём посылки: без него заказ по тарифу «от
# склада» не зарегистрировать. Коды по городу: scripts/cdek_points_probe.py
CDEK_SHIPMENT_POINT=
CDEK_DEFAULT_PACKAGE_WEIGHT_GRAMS=200

# Telegram-бот для уведомлений менеджера (создать через @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=
# Прокси перед api.telegram.org — из РФ он недоступен напрямую.
# Пусто = обращаться напрямую (годится для локальной разработки).
TELEGRAM_API_BASE_URL=
# Секрет, которым прокси отличает наши запросы от чужих (заголовок
# X-Proxy-Secret). Нужен, только если заполнен TELEGRAM_API_BASE_URL.
TELEGRAM_PROXY_SECRET=
# Отдельный чат для мини-отчётов по завершённым диалогам. Пусто = не слать.
TELEGRAM_REPORTS_CHAT_ID=
# Чат под заказы: новые заказы и проблемы с их регистрацией в СДЭКе.
# Пусто = пишем в чат менеджера.
TELEGRAM_ORDERS_CHAT_ID=
# Сколько диалог должен молчать, чтобы считаться завершённым
DIALOG_REPORT_IDLE_MINUTES=20
# Общий секрет для служебных эндпоинтов (их дёргает таймер Yandex Cloud).
# Пусто = служебные эндпоинты закрыты.
INTERNAL_API_TOKEN=
# Адрес контейнера из консоли Yandex Cloud («Ссылка для вызова»). Нужен
# только скрипту scripts/api.sh, самому боту — нет.
CONTAINER_URL=https://<идентификатор>.containers.yandexcloud.net
# Ozon Доставка (кабинет -> Настройки -> Управление частными приложениями)
OZON_CLIENT_ID=
OZON_CLIENT_SECRET=
# Идентификатор метода доставки из кабинета. Узнать: scripts/ozon_probe.py
OZON_SHIPMENT_METHOD_ID=
# Телефон для предварительного расчёта Ozon: он требует телефон в checkout,
# а цену клиент видит раньше, чем мы спросим его данные. В настоящий заказ
# уходит телефон получателя.
OZON_QUOTE_PHONE=+79000000000

# Почта России: пока false, бот её не предлагает и не принимает как способ
# доставки. Настоящего расчёта у неё нет, только плоский тариф.
RUSSIAN_POST_ENABLED=false
# Модуль оплаты. Пока false, на шаге оплаты заказ уходит менеджеру обычной
# эскалацией — он и присылает клиенту ссылку.
PAYMENTS_ENABLED=false

# ЮKassa. Идентификатор магазина — в кабинете, раздел Настройки → Магазин.
# Секретный ключ — Интеграция → Ключи API; у тестового магазина он доступен
# всегда, боевой выпускается отдельно и активируется паролем из смс.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда вернуть клиента после оплаты — страница сообщества ВКонтакте.
YOOKASSA_RETURN_URL=

# Очередь Yandex Message Queue. Пока хотя бы одно поле пустое, вебхук
# обрабатывает событие на месте, как раньше.
YMQ_QUEUE_URL=
YMQ_ACCESS_KEY_ID=
YMQ_SECRET_ACCESS_KEY=
