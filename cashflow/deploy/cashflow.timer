[Unit]
Description=Выгрузка выписки Т-Бизнеса в 07:00 и 21:00 по Москве

[Timer]
# Ежедневный запуск заодно продлевает жизнь токену: он действует
# 90 дней с момента последнего использования.
OnCalendar=*-*-* 07:00:00 Europe/Moscow
# Вечерний — чтобы проведённое за день и холды были видны в тот же вечер,
# а не наутро (с 16.10.2026).
OnCalendar=*-*-* 21:00:00 Europe/Moscow
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
