# Шаблон для /etc/cashflow/.env
# На сервере: владелец cashflow:cashflow, права 600. В git реальные значения не попадают.

# --- Т-Бизнес T-API ---
# Токен с доступом ТОЛЬКО «Счета и выписки». Сначала песочница, прод — после проверки.
TBANK_TOKEN=
# Песочница: https://business.tbank.ru/openapi/sandbox
# Прод:      https://business.tbank.ru/openapi
TBANK_API_BASE=https://business.tbank.ru/openapi/sandbox
# Номера счетов через запятую: основной, копилка, депозит
TBANK_ACCOUNTS=
# Дата открытия первого счёта — с неё идёт backfill
TBANK_FIRST_DAY=2024-01-01

# --- PostgreSQL ---
# Роль finance_sync, владелец схемы finance. Доступа к схемам приложения у неё нет.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=
PGUSER=finance_sync
PGPASSWORD=

# --- Сертификаты Минцифры ---
# Путь к bundle с Russian Trusted Root CA + Sub CA
REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt

# --- Уведомления об ошибках (необязательно) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Прочее ---
# Перекрытие при инкрементальной синхронизации, дней
SYNC_OVERLAP_DAYS=10
LOG_LEVEL=INFO
